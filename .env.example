# APIMyLlama Configuration
# Copy this to .env and customize:
#   cp .env.example .env

# Server port (default: 3000)
PORT=3000

# Ollama server URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Admin API token (optional — auto-generated with crypto.randomBytes if not set)
# Set this to a fixed value to persist across restarts:
# ADMIN_TOKEN=your-super-secure-token-here

# SQLite database path (default: ./apiKeys.db)
API_KEYS_DB_PATH=./apiKeys.db

# Node environment (production | development)
NODE_ENV=development
