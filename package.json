{
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node APIMyLlama.js",
    "dev": "nodemon APIMyLlama.js",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.js\" \"!ui/**\"",
    "format:check": "prettier --check \"**/*.js\" \"!ui/**\"",
    "build:ui": "cd ui && npm run build",
    "ui": "cd ui && npm run dev"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "compression": "^1.7.5",
    "express": "^5.2.1",
    "morgan": "^1.10.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "eslint": "^9.0.0",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.0",
    "prettier": "^3.5.0",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2"
  }
}
